# ─── Cloud-Claw Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in your values.

# ─── PostgreSQL — local installation ──────────────────────────────────────────
# Install PostgreSQL locally, create database "cloudclaw", then run schema:
#   psql -U cloudclaw -d cloudclaw -f src/database/schema.sql
DATABASE_URL=postgresql://cloudclaw:cloudclaw_dev_2026@localhost:5432/cloudclaw

# ─── LLM Provider ────────────────────────────────────────────────────────────
# MiniMax M2.7 via OpenAI-compatible SDK. NO OpenAI key needed or used.
# OPENAI_API_KEY is NOT required and must NOT be added.
LLM_API_KEY=your_minimax_api_key_here
LLM_BASE_URL=https://api.minimaxi.chat/v1
LLM_MODEL=MiniMax-M2.7
# Optional: auto-fallback provider after 3 consecutive LLM failures (circuit breaker)
# LLM_FALLBACK_PROVIDER=groq

# ─── Telegram (optional) ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:AAF...
TELEGRAM_USER_ID=123456789

# ─── Slack ────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_USER_ID=U012AB3CD

# ─── SSH ──────────────────────────────────────────────────────────────────────
SSH_PRIVATE_KEY_PATH=/home/ajul/.ssh/id_cloud_claw
SSH_USER=root
SSH_HOST=139.84.130.63
SSH_PORT=22

# ─── Voyage AI — semantic embeddings for fix memory ──────────────────────────
# Free tier: voyageai.com — voyage-code-2 is best for DevOps/technical content
# Dimension: 1536 (voyage-code-2 output size)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-code-2

# ─── Redis — required for PM2 cluster mode / multi-instance SSE bus ──────────
# Omit or leave empty to use in-memory fallback (single instance only).
# Docker: redis://redis:6379   Local: redis://localhost:6379
REDIS_URL=

# ─── Cloudstick Gateway (optional private HTTP API) ──────────────────────────
# Generate: openssl rand -hex 32
# Cloudstick backend signs requests with HMAC-SHA256 using this key.
CLOUDSTICK_GATEWAY_KEY=
CLOUDSTICK_GATEWAY_SIGNATURE_TOLERANCE_SECONDS=300
