{
  "name": "cloud-claw",
  "version": "1.0.0",
  "description": "Lean AIOps hub — autonomous server diagnostics and remediation",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:dashboard": "cd dashboard && npm run build",
    "start": "npm run build:dashboard && npm run build && node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "db:init": "psql $DATABASE_URL -f src/database/schema.sql"
  },
  "dependencies": {
    "@slack/bolt": "^4.6.0",
    "axios": "^1.13.6",
    "dotenv": "^16.4.5",
    "form-data": "^4.0.5",
    "grammy": "^1.31.0",
    "node-cron": "^4.2.1",
    "openai": "^4.80.0",
    "pg": "^8.20.0",
    "pgvector": "^0.2.0",
    "ssh2": "^1.16.0",
    "ws": "^8.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "@types/ssh2": "^1.15.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.0"
  }
}
