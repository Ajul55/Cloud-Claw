# ─── Cloud-Claw Docker Environment ────────────────────────────────────────────
# Copy this file to .env.docker and fill in your values before running:
#   cp .env.docker.example .env.docker
#
# [REQUIRED] vars must be set. Everything else is optional.

# ─── Database ─────────────────────────────────────────────────────────────────
# IMPORTANT: hostname must be "postgres" (the Docker Compose service name, NOT localhost)
# [REQUIRED]
DATABASE_URL=postgresql://cloudclaw:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/cloudclaw

# Must match the password in DATABASE_URL above
# [REQUIRED]
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# ─── Slack ────────────────────────────────────────────────────────────────────
# Get these from https://api.slack.com/apps → your app → OAuth & Permissions
# [REQUIRED for Slack interface]
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_USER_ID=U...

# Optional: restrict agent responses to a specific channel
SLACK_CHANNEL_ID=

# ─── Telegram (optional) ──────────────────────────────────────────────────────
# Leave blank to disable the Telegram interface
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Provider: openai | anthropic | groq | minimax
# [REQUIRED]
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# Base URL for OpenAI-compatible API (leave blank to use provider default)
LLM_API_BASE=

# API key for the selected provider
# [REQUIRED]
LLM_API_KEY=sk-...

# Additional provider keys (only needed if switching providers at runtime)
ANTHROPIC_API_KEY=
GROQ_API_KEY=
MINIMAX_API_KEY=

# ─── Cloudstick API ───────────────────────────────────────────────────────────
# [REQUIRED for Cloudstick features]
CLOUDSTICK_API_BASE=https://api.cloudstick.io
CLOUDSTICK_API_KEY=cs_live_...
CLOUDSTICK_API_SECRET=
CLOUDSTICK_USER_ID=

# WebSocket URL — only set if WS runs on a different host/port than the REST API
CLOUDSTICK_WS_BASE=

# Cloudstick Gateway shared secret — generate: openssl rand -hex 32
# [REQUIRED for HTTP gateway]
CLOUDSTICK_GATEWAY_KEY=

# ─── Encryption ───────────────────────────────────────────────────────────────
# AES-256-GCM key for encrypting SSH private keys at rest
# Generate: openssl rand -hex 32
# [REQUIRED if storing SSH keys via /setup or /setkey]
ENCRYPTION_KEY=

# ─── SSH (optional) ───────────────────────────────────────────────────────────
# Default SSH user for agent connections
SSH_USER=cloud-agent
SSH_PORT=22

# Paths inside the container (mounted from ./keys/ via docker-compose)
SSH_PRIVATE_KEY_PATH=/app/keys/id_rsa
SSH_PUBLIC_KEY_PATH=/app/keys/id_rsa.pub

# SSH Certificate Authority key (for signed cert auth)
SSH_CA_KEY_PATH=/app/keys/ca

# Default SSH host (optional — servers usually resolved per-request)
SSH_HOST=

# ─── Cloudflare (optional) ────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_DOMAIN=

# ─── Voyage AI — semantic fix memory (optional) ───────────────────────────────
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-code-2

# ─── Web Search (optional) ────────────────────────────────────────────────────
SERPAPI_KEY=

# ─── Sentinel ─────────────────────────────────────────────────────────────────
# Slack user ID or Telegram chat ID for proactive Sentinel alerts
PILOT_CHAT_ID=
